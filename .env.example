# Copie para .env para rodar localmente. Na Vercel, cadastre em Settings → Environment Variables.

# Banco de dados (criado sozinho ao conectar o Neon em Storage → Neon)
DATABASE_URL=

# Fotos enviadas pelo painel (criado sozinho ao conectar o Vercel Blob em Storage → Blob)
BLOB_READ_WRITE_TOKEN=

# Primeiro administrador — vale só enquanto não existir nenhum usuário.
ADMIN_EMAIL=
ADMIN_SENHA=

# Assinatura da sessão do painel (texto aleatório longo)
SESSION_SECRET=

# YouTube Data API v3 (sem ela, usa a chave já autorizada da TV ACIP)
YOUTUBE_API_KEY=

# Google Maps Embed API (opcional; sem ela, usa o mapa simples do Google)
VITE_GOOGLE_MAPS_KEY=
